# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
LOG_LEVEL=INFO

# WhatsApp Cloud API / Meta
# Create any random string and paste the same value into the Meta webhook setup.
WHATSAPP_VERIFY_TOKEN=make-a-random-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
ADMIN_API_KEY=make-a-random-admin-secret

# Gemini
# Get a free key from Google AI Studio and keep it out of source control.
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash-lite,gemini-2.0-flash

# Bot behavior
BOT_SYSTEM_PROMPT=You are a helpful WhatsApp assistant. Keep replies concise, friendly, and useful.
MAX_REPLY_CHARS=3500
